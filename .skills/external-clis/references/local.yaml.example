# Esquema de exemplo de .harness/local.yaml — só dados específicos da máquina.
# Nunca copie caminhos nem slugs reais da máquina deste repositório para
# este arquivo: ele é um exemplo, mantido portável com marcadores de posição.
#
# Ordem de resolução que a skill-mãe segue para cada CLI: primeiro `command -v
# <cli-name>`; se falhar, o caminho declarado em `binaries`
# abaixo; se nenhum resolver, o revisor é `not-run`.

# Linha opcional de nível superior, lida pelo Coordenador como texto simples (sem
# analisador): `always` ou `on-request`. Ela sobrepõe `defaults.worktree` da
# configuração global para este projeto nesta máquina; um valor inválido
# é reportado e ignorado.
worktree: on-request

binaries:
  # Um comando simples já no PATH, um caminho relativo ao diretório
  # pessoal (nunca um caminho absoluto expandido), ou um caminho relativo ao
  # projeto.
  <cli-name>: ~/.<cli-name>/bin/<cli-name>

models:
  # Slugs medidos nesta máquina para cada CLI, na ordem preferida
  # para o uso padrão dessa CLI. Nunca uma credencial nem um token.
  <cli-name>:
    - <slug>
    - <slug>
